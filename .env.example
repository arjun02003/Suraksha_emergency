# ============================================
# SURAKSHA Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# All VITE_ prefixed variables are exposed to the frontend.
# ============================================

# Mapbox Access Token
# Get yours at: https://account.mapbox.com/access-tokens/
# Leave empty until you have a valid token.
VITE_MAPBOX_ACCESS_TOKEN=

# Backend API URL
# VITE_API_BASE_URL=https://suraksha-emergency-4.onrender.com/api
